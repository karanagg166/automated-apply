# Non-secret frontend configuration only. Secrets belong in backend/.env.
FRONTEND_ORIGIN=http://localhost:3000
FRONTEND_LOCAL_HTTP=true
BACKEND_ORIGIN=http://127.0.0.1:8000

# Optional Rust private transport. Configure only during the reviewed whole-family cutover.
# The absolute socket must be owner-owned 0600 inside a canonical owner-owned 0700 directory.
# RUST_AGENT_URL=http://127.0.0.1:8011
# RUST_AGENT_UNIX_SOCKET=/absolute/canonical/private-directory/agent.sock
# BACKEND_UNIX_SOCKET=/absolute/canonical/private-directory/agent.sock
