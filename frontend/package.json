{
  "name": "automated-apply-frontend",
  "version": "0.7.0",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22",
    "pnpm": "12.15.0"
  },
  "scripts": {
    "preinstall": "node scripts/require-pnpm.mjs",
    "dev": "node run.mjs dev",
    "build": "next build",
    "start": "node run.mjs start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:browser": "playwright test --config playwright.browser.config.ts",
    "e2e:phase3": "playwright test --config playwright.phase3.config.ts",
    "api:types": "openapi-typescript ../reports/phase7-openapi.json -o src/types/api.d.ts && prettier --write src/types/api.d.ts",
    "format:check": "prettier --check src tests *.ts *.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@hookform/resolvers": "5.2.2",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-table": "8.21.3",
    "clsx": "2.1.1",
    "lucide-react": "1.59.0",
    "next": "16.4.5",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "type": "module"
}
