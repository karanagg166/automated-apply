          "type": "array"
        },
        "question": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "step_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Step Sha256",
          "type": "string"
        }
