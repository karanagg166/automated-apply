            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Days"
        },
        "follow_up": {
          "anyOf": [
            {
              "enum": [
                "filter",
                "selected",
                "prepare",
                "answer",
                "clarify"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Follow Up"
        },
        "job_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Job Id"
        },
        "location": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location"
        },
        "max_characters": {
          "default": 3500,
          "maximum": 3500,
          "minimum": 1,
          "title": "Max Characters",
          "type": "integer"
        },
        "max_words": {
          "default": 100,
          "maximum": 500,
          "minimum": 1,
          "title": "Max Words",
          "type": "integer"
        },
        "not_applied": {
          "default": false,
          "title": "Not Applied",
          "type": "boolean"
        },
        "project_rank": {
          "anyOf": [
            {
              "maximum": 30,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project Rank"
        },
        "remote": {
          "default": false,
          "title": "Remote",
          "type": "boolean"
        },
        "role": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        },
        "selection": {
          "anyOf": [
            {
              "maximum": 10,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selection"
        },
        "skills": {
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "title": "Skills",
          "type": "array"
        },
        "startup": {
          "default": false,
          "title": "Startup",
          "type": "boolean"
        },
        "subject": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject"
        },
        "url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2048,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "category"
      ],
      "title": "Intent",
      "type": "object"
    },
    "ManualControl": {
      "additionalProperties": false,
      "description": "Bounded explanation only; existing values and frame contents stay in Chrome.",
      "properties": {
        "context": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Context"
        },
        "control_id": {
          "pattern": "^u[0-9]{1,3}$",
          "title": "Control Id",
          "type": "string"
        },
        "invalid": {
          "default": false,
          "title": "Invalid",
          "type": "boolean"
        },
        "kind": {
          "maxLength": 160,
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "maxLength": 160,
          "title": "Label",
          "type": "string"
        },
        "reason": {
          "maxLength": 160,
          "title": "Reason",
          "type": "string"
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        }
      },
      "required": [
        "control_id",
        "kind",
        "label",
        "reason"
      ],
      "title": "ManualControl",
      "type": "object"
    },
    "NaukriExecutionObservation": {
      "additionalProperties": false,
      "properties": {
        "account_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Account Sha256",
          "type": "string"
        },
        "company": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Company"
        },
        "control_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Control Sha256"
        },
        "document_id": {
          "maxLength": 100,
          "minLength": 16,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Document Id",
          "type": "string"
        },
        "evidence_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Evidence Sha256",
          "type": "string"
        },
        "profile_fields": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "items": {},
                "type": "array"
              },
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "maxProperties": 18,
          "title": "Profile Fields",
          "type": "object"
        },
        "resume_bytes": {
          "anyOf": [
            {
              "maximum": 2000000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resume Bytes"
        },
        "resume_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resume Sha256"
        },
        "state": {
          "enum": [
            "PROFILE_VERIFIED",
            "NOT_APPLIED",
            "APPLIED",
            "CLICKED",
            "APPLICATION_SENT",
            "QUESTIONNAIRE",
            "PROFILE_OBSERVED",
            "PROFILE_SAVE_ATTEMPTED",
            "PROFILE_SKILLS_PREPARED"
          ],
          "title": "State",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        }
      },
      "required": [
        "state",
        "document_id",
        "evidence_sha256",
        "account_sha256"
      ],
      "title": "NaukriExecutionObservation",
      "type": "object"
    },
    "NaukriQuestionnaire": {
      "additionalProperties": false,
      "properties": {
        "answer_kind": {
          "enum": [
            "choice",
            "text",
            "file"
          ],
