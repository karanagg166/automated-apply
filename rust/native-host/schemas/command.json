          "title": "Kind",
          "type": "string"
        },
        "observed_url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2048,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Url"
        },
        "questionnaire": {
          "anyOf": [
            {
              "$ref": "#/$defs/NaukriQuestionnaire"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 64,
              "pattern": "^[a-zA-Z][a-zA-Z0-9_]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "requisition": {
          "anyOf": [
            {
              "pattern": "^[0-9]{10,20}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Requisition"
        },
        "stage": {
          "anyOf": [
            {
              "const": "ALREADY_APPLIED",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stage"
        },
        "step_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Step Sha256"
        },
        "submitted": {
          "const": false,
          "default": false,
          "title": "Submitted",
          "type": "boolean"
        }
      },
      "required": [
        "kind"
      ],
      "title": "NaukriWorkReport",
      "type": "object"
    },
