{
  "$defs": {
    "FieldResult": {
      "additionalProperties": false,
      "properties": {
        "field_id": {
          "pattern": "^f[0-9]{1,3}$",
          "title": "Field Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "filled",
            "failed",
            "needs_input",
            "validation_error",
            "untouched"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "field_id",
        "status"
      ],
      "title": "FieldResult",
      "type": "object"
    },
    "FillReceipt": {
      "additionalProperties": false,
      "properties": {
        "network_guard_active": {
          "default": false,
          "title": "Network Guard Active",
          "type": "boolean"
        },
        "plan_id": {
          "format": "uuid",
          "title": "Plan Id",
          "type": "string"
        },
        "results": {
          "items": {
            "$ref": "#/$defs/FieldResult"
          },
          "maxItems": 24,
          "title": "Results",
          "type": "array"
        },
        "state": {
          "enum": [
            "form_filled",
            "needs_input",
            "manual_required",
            "failed"
          ],
          "title": "State",
          "type": "string"
        },
        "submitted": {
          "const": false,
          "default": false,
          "title": "Submitted",
          "type": "boolean"
        },
        "verification_method": {
          "default": "dom_assignment",
          "enum": [
            "dom_assignment",
            "retained_after_blur"
          ],
          "title": "Verification Method",
          "type": "string"
        }
      },
      "required": [
        "plan_id",
        "results",
        "state"
      ],
      "title": "FillReceipt",
      "type": "object"
    },
    "FormField": {
      "additionalProperties": false,
      "properties": {
        "control_identity": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Control Identity"
        },
        "field_id": {
          "pattern": "^f[0-9]{1,3}$",
          "title": "Field Id",
          "type": "string"
        },
        "group_label": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Group Label"
        },
        "invalid": {
          "default": false,
          "title": "Invalid",
          "type": "boolean"
        },
        "kind": {
          "enum": [
            "text",
            "textarea",
            "email",
            "tel",
            "url",
            "number",
            "date",
            "month",
            "select",
            "radio",
            "checkbox",
            "file"
          ],
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "maxLength": 160,
          "title": "Label",
          "type": "string"
        },
        "manual_reason": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Manual Reason"
        },
        "max_length": {
          "default": 1500,
          "maximum": 4000,
          "minimum": 1,
          "title": "Max Length",
          "type": "integer"
        },
        "options": {
          "items": {
            "maxLength": 160,
            "type": "string"
          },
          "maxItems": 300,
          "title": "Options",
          "type": "array"
        },
        "page_step": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Step"
        },
        "preview_only": {
          "default": false,
          "title": "Preview Only",
          "type": "boolean"
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        },
        "section": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "semantic_key": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Semantic Key"
        }
      },
      "required": [
        "field_id",
        "kind",
        "label"
      ],
      "title": "FormField",
      "type": "object"
    },
    "Inspection": {
      "additionalProperties": false,
      "properties": {
        "challenge_state": {
          "default": "NONE",
          "enum": [
            "NONE",
            "WIDGET_PRESENT_UNVERIFIED",
            "CHALLENGE_BLOCKING",
            "MANUALLY_RESOLVED_AND_SITE_VERIFIED",
            "UNKNOWN"
          ],
          "title": "Challenge State",
          "type": "string"
        },
        "completed_count": {
          "default": 0,
          "maximum": 1000,
          "minimum": 0,
          "title": "Completed Count",
          "type": "integer"
        },
        "document_id": {
          "pattern": "^[a-f0-9-]{36}$",
          "title": "Document Id",
          "type": "string"
        },
        "fields": {
          "items": {
            "$ref": "#/$defs/FormField"
          },
          "maxItems": 24,
          "title": "Fields",
          "type": "array"
        },
        "has_next": {
          "default": false,
          "title": "Has Next",
          "type": "boolean"
        },
        "has_submit": {
          "default": false,
          "title": "Has Submit",
          "type": "boolean"
        },
        "manual_controls": {
          "items": {
            "$ref": "#/$defs/ManualControl"
          },
          "maxItems": 48,
          "title": "Manual Controls",
          "type": "array"
        },
        "manual_reason": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Manual Reason"
        },
        "state": {
          "default": "ready",
          "enum": [
            "ready",
            "login_required",
            "manual_required",
            "unsupported",
            "validation_errors"
          ],
          "title": "State",
          "type": "string"
        },
        "url": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "version": {
          "const": 1,
          "default": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "document_id",
        "url"
      ],
      "title": "Inspection",
      "type": "object"
    },
    "Intent": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "enum": [
            "FIND_JOBS",
            "FILTER_JOBS",
            "SHOW_JOB",
            "PREPARE_APPLICATION",
            "APPLICATION_STATUS",
            "CONNECTION_STATUS",
            "GMAIL_DRAFT_PREVIEW",
            "FOUNDER_RESEARCH_PREVIEW",
            "HELP",
            "UNKNOWN",
            "GENERAL_CHAT",
            "FOLLOW_UP",
            "JOB_COMPARISON",
            "PROFILE_QUERY",
            "PROJECT_QUERY",
            "RESUME_STATUS",
            "APPROVAL_REQUEST",
            "RESET_CONTEXT",
            "ANSWER_PREPARATION"
          ],
          "title": "Category",
          "type": "string"
        },
        "company": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
