            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Company"
        },
        "connection": {
          "anyOf": [
            {
              "enum": [
                "gmail",
                "telegram",
                "supabase",
                "chrome",
                "agy",
                "naukri",
                "wellfound",
                "instahyre",
                "internshala",
                "yc"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Connection"
        },
        "days": {
          "anyOf": [
            {
              "maximum": 365,
              "minimum": 1,
              "type": "integer"
