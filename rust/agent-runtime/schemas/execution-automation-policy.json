{
  "additionalProperties": false,
  "description": "Preparation authority only; unsupported employer actions cannot be enabled.",
  "properties": {
    "allowed_locations": {
      "items": {
        "type": "string"
      },
      "maxItems": 25,
      "minItems": 1,
      "title": "Allowed Locations",
      "type": "array"
    },
    "allowed_roles": {
      "items": {
        "type": "string"
      },
      "maxItems": 25,
      "minItems": 1,
      "title": "Allowed Roles",
      "type": "array"
    },
    "excluded_companies": {
      "items": {
        "type": "string"
      },
      "maxItems": 100,
      "title": "Excluded Companies",
      "type": "array"
    },
    "experience_max": {
      "maximum": 60,
      "minimum": 0,
      "title": "Experience Max",
      "type": "number"
    },
    "experience_min": {
      "maximum": 60,
      "minimum": 0,
      "title": "Experience Min",
      "type": "number"
    },
    "gmail_account_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Gmail Account Id"
    },
    "gmail_policy_version": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Gmail Policy Version"
    },
    "interval_seconds": {
      "default": 21600,
      "maximum": 604800,
      "minimum": 900,
      "title": "Interval Seconds",
      "type": "integer"
    },
    "max_applications_per_day": {
      "const": 0,
      "default": 0,
      "title": "Max Applications Per Day",
      "type": "integer"
    },
    "max_posting_age_days": {
      "default": 14,
      "maximum": 30,
      "minimum": 1,
      "title": "Max Posting Age Days",
      "type": "integer"
    },
    "max_preparations_per_day": {
      "default": 5,
      "maximum": 25,
      "minimum": 1,
      "title": "Max Preparations Per Day",
      "type": "integer"
    },
    "minimum_match_score": {
      "default": 80,
      "maximum": 100,
      "minimum": 80,
      "title": "Minimum Match Score",
      "type": "integer"
    },
    "permitted_actions": {
      "items": {
        "const": "PREPARATION",
        "type": "string"
      },
      "maxItems": 1,
      "minItems": 1,
      "title": "Permitted Actions",
      "type": "array"
    },
    "permitted_platform": {
      "const": "naukri",
      "default": "naukri",
      "title": "Permitted Platform",
      "type": "string"
    },
    "profile_version": {
      "minimum": 1,
      "title": "Profile Version",
      "type": "integer"
    },
    "resume_resource_id": {
      "format": "uuid",
      "title": "Resume Resource Id",
      "type": "string"
    },
    "resume_version": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Resume Version",
      "type": "string"
    },
    "source": {
      "default": "saved_owner_imports",
      "enum": [
        "saved_owner_imports",
        "gmail_job_alerts"
      ],
      "title": "Source",
      "type": "string"
    },
    "telegram_questions": {
      "default": false,
      "title": "Telegram Questions",
      "type": "boolean"
    }
  },
  "required": [
    "profile_version",
    "resume_resource_id",
    "resume_version",
    "allowed_roles",
    "allowed_locations",
    "experience_min",
    "experience_max"
  ],
  "title": "AutomationPolicy",
  "type": "object"
}
