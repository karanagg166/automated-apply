{
  "$defs": {
    "FormField": {
      "additionalProperties": false,
      "properties": {
        "control_identity": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Control Identity"
        },
        "field_id": {
          "pattern": "^f[0-9]{1,3}$",
          "title": "Field Id",
          "type": "string"
        },
        "group_label": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Group Label"
        },
        "invalid": {
          "default": false,
          "title": "Invalid",
          "type": "boolean"
        },
        "kind": {
          "enum": [
            "text",
            "textarea",
            "email",
            "tel",
            "url",
            "number",
            "date",
            "month",
            "select",
            "radio",
            "checkbox",
            "file"
          ],
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "maxLength": 160,
          "title": "Label",
          "type": "string"
        },
        "manual_reason": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Manual Reason"
        },
        "max_length": {
          "default": 1500,
          "maximum": 4000,
          "minimum": 1,
          "title": "Max Length",
          "type": "integer"
        },
        "options": {
          "items": {
            "maxLength": 160,
            "type": "string"
          },
          "maxItems": 300,
          "title": "Options",
          "type": "array"
        },
        "page_step": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Step"
        },
        "preview_only": {
          "default": false,
          "title": "Preview Only",
          "type": "boolean"
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        },
        "section": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "semantic_key": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Semantic Key"
        }
      },
      "required": [
        "field_id",
        "kind",
        "label"
      ],
      "title": "FormField",
      "type": "object"
    },
    "ManualControl": {
      "additionalProperties": false,
      "description": "Bounded explanation only; existing values and frame contents stay in Chrome.",
      "properties": {
        "context": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Context"
        },
        "control_id": {
          "pattern": "^u[0-9]{1,3}$",
          "title": "Control Id",
          "type": "string"
        },
        "invalid": {
          "default": false,
          "title": "Invalid",
          "type": "boolean"
        },
        "kind": {
          "maxLength": 160,
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "maxLength": 160,
          "title": "Label",
          "type": "string"
        },
        "reason": {
          "maxLength": 160,
          "title": "Reason",
          "type": "string"
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        }
      },
      "required": [
        "control_id",
        "kind",
        "label",
        "reason"
      ],
      "title": "ManualControl",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "challenge_state": {
      "default": "NONE",
      "enum": [
        "NONE",
        "WIDGET_PRESENT_UNVERIFIED",
        "CHALLENGE_BLOCKING",
        "MANUALLY_RESOLVED_AND_SITE_VERIFIED",
        "UNKNOWN"
      ],
      "title": "Challenge State",
      "type": "string"
    },
    "completed_count": {
      "default": 0,
      "maximum": 1000,
      "minimum": 0,
      "title": "Completed Count",
      "type": "integer"
    },
    "document_id": {
      "pattern": "^[a-f0-9-]{36}$",
      "title": "Document Id",
      "type": "string"
    },
    "fields": {
      "items": {
        "$ref": "#/$defs/FormField"
      },
      "maxItems": 24,
      "title": "Fields",
      "type": "array"
    },
    "has_next": {
      "default": false,
      "title": "Has Next",
      "type": "boolean"
    },
    "has_submit": {
      "default": false,
      "title": "Has Submit",
      "type": "boolean"
    },
    "manual_controls": {
      "items": {
        "$ref": "#/$defs/ManualControl"
      },
      "maxItems": 48,
      "title": "Manual Controls",
      "type": "array"
    },
    "manual_reason": {
      "anyOf": [
        {
          "maxLength": 160,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Manual Reason"
    },
    "state": {
      "default": "ready",
      "enum": [
        "ready",
        "login_required",
        "manual_required",
        "unsupported",
        "validation_errors"
      ],
      "title": "State",
      "type": "string"
    },
    "url": {
      "maxLength": 2048,
      "minLength": 1,
      "title": "Url",
      "type": "string"
    },
    "version": {
      "const": 1,
      "default": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "document_id",
    "url"
  ],
  "title": "Inspection",
  "type": "object"
}
