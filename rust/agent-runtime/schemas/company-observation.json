{
  "additionalProperties": false,
  "properties": {
    "authoritative_statement": {
      "default": false,
      "title": "Authoritative Statement",
      "type": "boolean"
    },
    "careers_url": {
      "anyOf": [
        {
          "format": "uri",
          "maxLength": 2048,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Careers Url"
    },
    "country": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Country"
    },
    "description": {
      "anyOf": [
        {
          "maxLength": 4000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "domain": {
      "anyOf": [
        {
          "maxLength": 255,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Domain"
    },
    "employee_count": {
      "anyOf": [
        {
          "maximum": 10000000,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Employee Count"
    },
    "founding_year": {
      "anyOf": [
        {
          "maximum": 2100,
          "minimum": 1800,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Founding Year"
    },
    "hiring_statement": {
      "anyOf": [
        {
          "enum": [
            "hiring_possible",
            "not_currently_hiring"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Hiring Statement"
    },
    "historical": {
      "default": false,
      "title": "Historical",
      "type": "boolean"
    },
    "industry": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Industry"
    },
    "location": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Location"
    },
    "name": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "permission_evidence_url": {
      "format": "uri",
      "maxLength": 2048,
      "minLength": 1,
      "title": "Permission Evidence Url",
      "type": "string"
    },
    "product_category": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Product Category"
    },
    "remote_policy": {
      "default": "unknown",
      "enum": [
        "remote",
        "hybrid",
        "onsite",
        "unknown"
      ],
      "title": "Remote Policy",
      "type": "string"
    },
    "source": {
      "pattern": "^[a-z_]{2,50}$",
      "title": "Source",
      "type": "string"
    },
    "source_company_id": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Company Id"
    },
    "source_url": {
      "format": "uri",
      "maxLength": 2048,
      "minLength": 1,
      "title": "Source Url",
      "type": "string"
    },
    "stage": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stage"
    },
    "team_size_band": {
      "default": "unknown",
      "enum": [
        "2-10",
        "1-10",
        "11-50",
        "51-200",
        "201-500",
        "500+",
        "unknown"
      ],
      "title": "Team Size Band",
      "type": "string"
    },
    "technology_stack": {
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 30,
      "title": "Technology Stack",
      "type": "array"
    },
    "verification_status": {
      "default": "requires_review",
      "enum": [
        "source_reported",
        "human_confirmed",
        "requires_review"
      ],
      "title": "Verification Status",
      "type": "string"
    },
    "yc_batch": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Yc Batch"
    }
  },
  "required": [
    "name",
    "source",
    "source_url",
    "permission_evidence_url",
    "observed_at"
  ],
  "title": "CompanyObservation",
  "type": "object"
}
