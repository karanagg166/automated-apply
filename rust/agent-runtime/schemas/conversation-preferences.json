{
  "$defs": {
    "CompensationFact": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "anyOf": [
            {
              "maximum": 1000000000000.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Amount"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "kind": {
          "enum": [
            "ctc",
            "base_salary",
            "total_compensation"
          ],
          "title": "Kind",
          "type": "string"
        },
        "period": {
          "enum": [
            "hour",
            "month",
            "year"
          ],
          "title": "Period",
          "type": "string"
        }
      },
      "required": [
        "amount",
        "currency",
        "period",
        "kind"
      ],
      "title": "CompensationFact",
      "type": "object"
    },
    "CountryAuthorization": {
      "additionalProperties": false,
      "properties": {
        "authorized_to_work": {
          "title": "Authorized To Work",
          "type": "boolean"
        },
        "country_code": {
          "pattern": "^[A-Z]{2}$",
          "title": "Country Code",
          "type": "string"
        },
        "country_name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Country Name",
          "type": "string"
        },
        "requires_sponsorship_now_or_future": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Requires Sponsorship Now Or Future"
        }
      },
      "required": [
        "country_code",
        "country_name",
        "authorized_to_work"
      ],
      "title": "CountryAuthorization",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "application_status": {
      "default": "not_applied",
      "enum": [
        "all",
        "applied",
        "not_applied"
      ],
      "title": "Application Status",
      "type": "string"
    },
    "availability_date": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Availability Date"
    },
    "company_stages": {
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 100,
      "title": "Company Stages",
      "type": "array"
    },
    "current_compensation": {
      "anyOf": [
        {
          "$ref": "#/$defs/CompensationFact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "current_location": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Current Location"
    },
    "duplicate_prevention": {
      "const": true,
      "default": true,
      "title": "Duplicate Prevention",
      "type": "boolean"
    },
    "employment_types": {
      "items": {
        "enum": [
          "full_time",
          "internship",
          "contract"
        ],
        "type": "string"
      },
      "maxItems": 3,
      "title": "Employment Types",
      "type": "array"
    },
    "excluded_companies": {
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 100,
      "title": "Excluded Companies",
      "type": "array"
    },
    "excluded_keywords": {
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 100,
      "title": "Excluded Keywords",
      "type": "array"
    },
    "excluded_titles": {
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 100,
      "title": "Excluded Titles",
      "type": "array"
    },
    "expected_compensation": {
      "anyOf": [
        {
          "$ref": "#/$defs/CompensationFact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "maximum_employees": {
      "anyOf": [
        {
          "maximum": 10000000,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Maximum Employees"
    },
    "maximum_experience": {
      "anyOf": [
        {
          "maximum": 100,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Maximum Experience"
    },
    "maximum_salary": {
      "anyOf": [
        {
          "maximum": 1000000000000.0,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Maximum Salary"
    },
    "minimum_employees": {
      "anyOf": [
        {
          "maximum": 10000000,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Minimum Employees"
    },
    "minimum_experience": {
      "anyOf": [
        {
          "maximum": 100,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Minimum Experience"
    },
    "minimum_salary": {
      "anyOf": [
        {
          "maximum": 1000000000000.0,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Minimum Salary"
    },
    "notice_period_days": {
      "anyOf": [
        {
          "maximum": 3650,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notice Period Days"
    },
    "open_to_relocation": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Open To Relocation"
    },
    "posting_recency_days": {
      "default": 30,
      "maximum": 365,
      "minimum": 1,
      "title": "Posting Recency Days",
      "type": "integer"
    },
    "preferred_locations": {
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 100,
      "title": "Preferred Locations",
      "type": "array"
    },
    "prioritize_startups": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prioritize Startups"
    },
    "relevance_threshold": {
      "default": 0,
      "maximum": 100,
      "minimum": 0,
      "title": "Relevance Threshold",
      "type": "number"
    },
    "relocation_locations": {
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 100,
      "title": "Relocation Locations",
      "type": "array"
    },
    "remote_preference": {
      "anyOf": [
        {
          "enum": [
            "remote",
            "hybrid",
            "onsite",
            "any"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Remote Preference"
    },
    "require_known_properties": {
      "const": true,
      "default": true,
      "title": "Require Known Properties",
      "type": "boolean"
    },
    "salary_currency": {
      "anyOf": [
        {
          "pattern": "^[A-Z]{3}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Salary Currency"
    },
    "salary_period": {
      "anyOf": [
        {
          "enum": [
            "hour",
            "day",
            "week",
            "month",
            "year"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Salary Period"
    },
    "saved_jobs_only": {
      "default": false,
      "title": "Saved Jobs Only",
      "type": "boolean"
    },
    "source_platforms": {
      "items": {
        "type": "string"
      },
      "maxItems": 20,
      "title": "Source Platforms",
      "type": "array"
    },
    "target_industries": {
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 100,
      "title": "Target Industries",
      "type": "array"
    },
    "target_titles": {
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 100,
      "title": "Target Titles",
      "type": "array"
    },
    "technology_stacks": {
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 100,
      "title": "Technology Stacks",
      "type": "array"
    },
    "work_authorization": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Work Authorization"
    },
    "work_authorizations": {
      "items": {
        "$ref": "#/$defs/CountryAuthorization"
      },
      "maxItems": 20,
      "title": "Work Authorizations",
      "type": "array"
    }
  },
  "title": "SearchPreferences",
  "type": "object"
}
