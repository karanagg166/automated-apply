{
  "$defs": {
    "DiscoveryQuery": {
      "additionalProperties": false,
      "properties": {
        "employment_types": {
          "items": {
            "enum": [
              "full_time",
              "part_time",
              "contract",
              "internship"
            ],
            "type": "string"
          },
          "maxItems": 4,
          "title": "Employment Types",
          "type": "array"
        },
        "keywords": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 10,
          "title": "Keywords",
          "type": "array"
        },
        "limit": {
          "default": 20,
          "maximum": 100,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "locations": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 10,
          "title": "Locations",
          "type": "array"
        },
        "max_age_days": {
          "anyOf": [
            {
              "maximum": 3650,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Age Days"
        },
        "page": {
          "default": 1,
          "maximum": 100,
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "remote_preference": {
          "anyOf": [
            {
              "enum": [
                "remote",
                "hybrid",
                "onsite",
                "any"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Remote Preference"
        }
      },
      "title": "DiscoveryQuery",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "allow_paid": {
      "default": false,
      "title": "Allow Paid",
      "type": "boolean"
    },
    "idempotency_key": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9_-]{1,100}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Idempotency Key"
    },
    "manual_jobs": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "maxItems": 100,
      "title": "Manual Jobs",
      "type": "array"
    },
    "query": {
      "$ref": "#/$defs/DiscoveryQuery"
    },
    "source": {
      "pattern": "^[a-z_]{2,50}$",
      "title": "Source",
      "type": "string"
    },
    "use_profile": {
      "default": true,
      "title": "Use Profile",
      "type": "boolean"
    }
  },
  "required": [
    "source"
  ],
  "title": "RunRequest",
  "type": "object"
}
