{
  "$defs": {
    "SubmissionEvidence": {
      "additionalProperties": false,
      "properties": {
        "application_id": {
          "pattern": "^fixture-[a-z0-9-]{1,80}$",
          "title": "Application Id",
          "type": "string"
        },
        "correlation_id": {
          "format": "uuid",
          "title": "Correlation Id",
          "type": "string"
        },
        "destination": {
          "title": "Destination",
          "type": "string"
        },
        "timestamp": {
          "title": "Timestamp",
          "type": "string"
        },
        "type": {
          "enum": [
            "application_acknowledgment",
            "employer_confirmation_response",
            "known_confirmation_page"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "destination",
        "timestamp",
        "application_id",
        "correlation_id"
      ],
      "title": "SubmissionEvidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "adapter": {
      "enum": [
        "greenhouse",
        "lever",
        "google"
      ],
      "title": "Adapter",
      "type": "string"
    },
    "application_id": {
      "format": "uuid",
      "title": "Application Id",
      "type": "string"
    },
    "application_url": {
      "title": "Application Url",
      "type": "string"
    },
    "authorization": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Authorization"
    },
    "campaign_id": {
      "format": "uuid",
      "title": "Campaign Id",
      "type": "string"
    },
    "campaign_revision": {
      "title": "Campaign Revision",
      "type": "integer"
    },
    "cancelled": {
      "default": false,
      "title": "Cancelled",
      "type": "boolean"
    },
    "candidate_profile_id": {
      "format": "uuid",
      "title": "Candidate Profile Id",
      "type": "string"
    },
    "candidate_version": {
      "title": "Candidate Version",
      "type": "integer"
    },
    "command_campaign_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "maxItems": 20,
      "title": "Command Campaign Ids",
      "type": "array"
    },
    "confirmation_url": {
      "title": "Confirmation Url",
      "type": "string"
    },
    "context_digest": {
      "title": "Context Digest",
      "type": "string"
    },
    "dispatch_started_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Dispatch Started At"
    },
    "document_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Document Digest",
      "type": "string"
    },
    "document_id": {
      "title": "Document Id",
      "type": "string"
    },
    "employer": {
      "title": "Employer",
      "type": "string"
    },
    "employer_id": {
      "format": "uuid",
      "title": "Employer Id",
      "type": "string"
    },
    "evidence": {
      "anyOf": [
        {
          "$ref": "#/$defs/SubmissionEvidence"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "expires_at": {
      "title": "Expires At",
      "type": "string"
    },
    "fence": {
      "default": 0,
      "title": "Fence",
      "type": "integer"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "idempotency_key": {
      "format": "uuid",
      "title": "Idempotency Key",
      "type": "string"
    },
    "job_id": {
      "format": "uuid",
      "title": "Job Id",
      "type": "string"
    },
    "job_title": {
      "title": "Job Title",
      "type": "string"
    },
    "lease_until": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lease Until"
    },
    "nonce": {
      "format": "uuid",
      "title": "Nonce",
      "type": "string"
    },
    "origin": {
      "title": "Origin",
      "type": "string"
    },
    "owner": {
      "const": "primary",
      "default": "primary",
      "title": "Owner",
      "type": "string"
    },
    "packet_revision": {
      "title": "Packet Revision",
      "type": "integer"
    },
    "pdf_digest": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pdf Digest"
    },
    "plan_id": {
      "format": "uuid",
      "title": "Plan Id",
      "type": "string"
    },
    "project_digest": {
      "title": "Project Digest",
      "type": "string"
    },
    "reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason"
    },
    "receipt_url": {
      "title": "Receipt Url",
      "type": "string"
    },
    "released": {
      "default": false,
      "title": "Released",
      "type": "boolean"
    },
    "request_url": {
      "title": "Request Url",
      "type": "string"
    },
    "review_digest": {
      "default": "",
      "title": "Review Digest",
      "type": "string"
    },
    "revision": {
      "default": 0,
      "title": "Revision",
      "type": "integer"
    },
    "state": {
      "default": "prepared",
      "enum": [
        "prepared",
        "form_inspected",
        "form_filled",
        "awaiting_submission_approval",
        "submitting",
        "submitted",
        "submission_uncertain",
        "manual_required",
        "failed"
      ],
      "title": "State",
      "type": "string"
    }
  },
  "required": [
    "application_id",
    "job_id",
    "employer_id",
    "employer",
    "job_title",
    "plan_id",
    "campaign_id",
    "campaign_revision",
    "candidate_profile_id",
    "candidate_version",
    "context_digest",
    "packet_revision",
    "project_digest",
    "document_id",
    "document_digest",
    "adapter",
    "origin",
    "application_url",
    "request_url",
    "confirmation_url",
    "receipt_url",
    "expires_at"
  ],
  "title": "Submission",
  "type": "object"
}
