{
  "$defs": {
    "Certification": {
      "additionalProperties": false,
      "properties": {
        "credential_url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2048,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Credential Url"
        },
        "issued_on": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Issued On"
        },
        "issuer": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Issuer"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "Certification",
      "type": "object"
    },
    "CompensationFact": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "anyOf": [
            {
              "maximum": 1000000000000.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Amount"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "kind": {
          "enum": [
            "ctc",
            "base_salary",
            "total_compensation"
          ],
          "title": "Kind",
          "type": "string"
        },
        "period": {
          "enum": [
            "hour",
            "month",
            "year"
          ],
          "title": "Period",
          "type": "string"
        }
      },
      "required": [
        "amount",
        "currency",
        "period",
        "kind"
      ],
      "title": "CompensationFact",
      "type": "object"
    },
    "CountryAuthorization": {
      "additionalProperties": false,
      "properties": {
        "authorized_to_work": {
          "title": "Authorized To Work",
          "type": "boolean"
        },
        "country_code": {
          "pattern": "^[A-Z]{2}$",
          "title": "Country Code",
          "type": "string"
        },
        "country_name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Country Name",
          "type": "string"
        },
        "requires_sponsorship_now_or_future": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Requires Sponsorship Now Or Future"
        }
      },
      "required": [
        "country_code",
        "country_name",
        "authorized_to_work"
      ],
      "title": "CountryAuthorization",
      "type": "object"
    },
    "EducationRecord": {
      "additionalProperties": false,
      "properties": {
        "field_of_study": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field Of Study"
        },
        "graduation_year": {
          "anyOf": [
            {
              "maximum": 2200,
              "minimum": 1900,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Graduation Year"
        },
        "institution": {
          "maxLength": 200,
          "minLength": 1,
