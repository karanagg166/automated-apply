          "type": "array"
        },
        "target_titles": {
          "default": null,
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 100,
          "title": "Target Titles",
          "type": "array"
        },
        "technology_stacks": {
          "default": null,
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 100,
          "title": "Technology Stacks",
          "type": "array"
        },
        "work_authorization": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
