          "type": "string"
        },
        "qualification": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Qualification",
          "type": "string"
        }
      },
      "required": [
        "institution",
        "qualification"
      ],
      "title": "EducationRecord",
      "type": "object"
    },
    "JobSearchPreferencesUpdate": {
