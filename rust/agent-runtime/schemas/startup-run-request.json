{
  "$defs": {
    "CompanyObservation": {
      "additionalProperties": false,
      "properties": {
        "authoritative_statement": {
          "default": false,
          "title": "Authoritative Statement",
          "type": "boolean"
        },
        "careers_url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2048,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Careers Url"
        },
        "country": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Country"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 4000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "domain": {
          "anyOf": [
            {
              "maxLength": 255,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Domain"
        },
        "employee_count": {
          "anyOf": [
            {
              "maximum": 10000000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Employee Count"
        },
        "founding_year": {
          "anyOf": [
            {
              "maximum": 2100,
              "minimum": 1800,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Founding Year"
        },
        "hiring_statement": {
          "anyOf": [
            {
              "enum": [
                "hiring_possible",
                "not_currently_hiring"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hiring Statement"
        },
        "historical": {
          "default": false,
          "title": "Historical",
          "type": "boolean"
        },
        "industry": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Industry"
        },
        "location": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "permission_evidence_url": {
          "format": "uri",
          "maxLength": 2048,
          "minLength": 1,
          "title": "Permission Evidence Url",
          "type": "string"
        },
        "product_category": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Product Category"
        },
        "remote_policy": {
          "default": "unknown",
          "enum": [
            "remote",
            "hybrid",
            "onsite",
            "unknown"
          ],
          "title": "Remote Policy",
          "type": "string"
        },
        "source": {
          "pattern": "^[a-z_]{2,50}$",
          "title": "Source",
          "type": "string"
        },
        "source_company_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Company Id"
        },
        "source_url": {
          "format": "uri",
          "maxLength": 2048,
          "minLength": 1,
          "title": "Source Url",
          "type": "string"
        },
        "stage": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stage"
        },
        "team_size_band": {
          "default": "unknown",
          "enum": [
            "2-10",
            "1-10",
            "11-50",
            "51-200",
            "201-500",
            "500+",
            "unknown"
          ],
          "title": "Team Size Band",
          "type": "string"
        },
        "technology_stack": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 30,
          "title": "Technology Stack",
          "type": "array"
        },
        "verification_status": {
          "default": "requires_review",
          "enum": [
            "source_reported",
            "human_confirmed",
            "requires_review"
          ],
          "title": "Verification Status",
          "type": "string"
        },
        "yc_batch": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Yc Batch"
        }
      },
      "required": [
        "name",
        "source",
        "source_url",
        "permission_evidence_url",
        "observed_at"
      ],
      "title": "CompanyObservation",
      "type": "object"
    },
    "DiscoveryQuery": {
      "additionalProperties": false,
      "properties": {
        "employment_types": {
          "items": {
            "enum": [
              "full_time",
              "part_time",
              "contract",
              "internship"
            ],
            "type": "string"
          },
          "maxItems": 4,
          "title": "Employment Types",
          "type": "array"
        },
        "keywords": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 10,
          "title": "Keywords",
          "type": "array"
        },
        "limit": {
          "default": 20,
          "maximum": 100,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "locations": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 10,
          "title": "Locations",
          "type": "array"
        },
        "max_age_days": {
          "anyOf": [
            {
              "maximum": 3650,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Age Days"
        },
        "page": {
          "default": 1,
          "maximum": 100,
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "remote_preference": {
          "anyOf": [
            {
              "enum": [
                "remote",
                "hybrid",
                "onsite",
                "any"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Remote Preference"
        }
      },
      "title": "DiscoveryQuery",
      "type": "object"
    },
    "StartupFilters": {
      "additionalProperties": false,
      "properties": {
        "application_status": {
          "default": "all",
          "enum": [
            "all",
            "not_applied",
            "shortlisted",
            "packet_prepared",
            "applied",
            "interview",
            "rejected"
          ],
          "title": "Application Status",
          "type": "string"
        },
        "country": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Country"
        },
        "early_stage": {
          "default": false,
          "title": "Early Stage",
          "type": "boolean"
        },
        "exact_employee_count": {
          "default": false,
          "title": "Exact Employee Count",
          "type": "boolean"
        },
        "freshness_days": {
          "default": 30,
          "maximum": 365,
          "minimum": 1,
          "title": "Freshness Days",
          "type": "integer"
        },
        "has_business_email": {
          "default": false,
          "title": "Has Business Email",
          "type": "boolean"
        },
        "has_leader_evidence": {
          "default": false,
          "title": "Has Leader Evidence",
          "type": "boolean"
        },
        "has_technical_staff": {
          "default": false,
          "title": "Has Technical Staff",
          "type": "boolean"
        },
        "hiring_status": {
          "anyOf": [
            {
              "enum": [
                "hiring_confirmed",
                "hiring_possible",
                "hiring_unknown",
                "not_currently_hiring"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hiring Status"
        },
        "include_unknown_size": {
          "default": true,
          "title": "Include Unknown Size",
          "type": "boolean"
        },
        "industries": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "title": "Industries",
          "type": "array"
        },
        "limit": {
          "default": 20,
          "maximum": 100,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "locations": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 10,
          "title": "Locations",
          "type": "array"
        },
        "max_employees": {
          "anyOf": [
            {
              "maximum": 10000000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": 50,
          "title": "Max Employees"
        },
        "min_employees": {
          "anyOf": [
            {
              "maximum": 10000000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Employees"
        },
        "minimum_score": {
          "default": 0,
          "maximum": 100,
          "minimum": 0,
          "title": "Minimum Score",
          "type": "number"
        },
        "observed_after": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed After"
        },
        "page": {
          "default": 1,
          "maximum": 250,
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "query": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query"
        },
        "remote_preference": {
          "anyOf": [
            {
              "enum": [
                "remote",
                "hybrid",
                "onsite",
                "any"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Remote Preference"
        },
        "roles": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 10,
          "title": "Roles",
          "type": "array"
        },
        "size_bands": {
          "items": {
            "enum": [
              "2-10",
              "1-10",
              "11-50",
              "51-200",
              "201-500",
              "500+",
              "unknown"
            ],
            "type": "string"
          },
          "maxItems": 6,
          "title": "Size Bands",
          "type": "array"
        },
        "skills": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 30,
          "title": "Skills",
          "type": "array"
        },
        "source": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "stages": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 10,
          "title": "Stages",
          "type": "array"
        },
        "use_profile": {
          "default": true,
          "title": "Use Profile",
          "type": "boolean"
        },
        "verified_yc": {
          "default": false,
          "title": "Verified Yc",
          "type": "boolean"
        },
        "yc_batch": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Yc Batch"
        }
      },
      "title": "StartupFilters",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "allow_paid": {
      "default": false,
      "title": "Allow Paid",
      "type": "boolean"
    },
    "companies": {
      "items": {
        "$ref": "#/$defs/CompanyObservation"
      },
      "maxItems": 100,
      "title": "Companies",
      "type": "array"
    },
    "filters": {
      "$ref": "#/$defs/StartupFilters"
    },
    "idempotency_key": {
      "pattern": "^[A-Za-z0-9_-]{8,100}$",
      "title": "Idempotency Key",
      "type": "string"
    },
    "mode": {
      "default": "company_first",
      "enum": [
        "company_first",
        "job_led"
      ],
      "title": "Mode",
      "type": "string"
    },
    "permission_confirmed": {
      "default": false,
      "title": "Permission Confirmed",
      "type": "boolean"
    },
    "query": {
      "$ref": "#/$defs/DiscoveryQuery"
    },
    "source": {
      "default": "manual",
      "pattern": "^[a-z_]{2,50}$",
      "title": "Source",
      "type": "string"
    }
  },
  "required": [
    "idempotency_key"
  ],
  "title": "StartupRunRequest",
  "type": "object"
}
