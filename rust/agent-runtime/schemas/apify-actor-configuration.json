{
  "additionalProperties": false,
  "properties": {
    "account_spending_limit_verified": {
      "default": false,
      "title": "Account Spending Limit Verified",
      "type": "boolean"
    },
    "actor_id": {
      "pattern": "^[A-Za-z0-9_-]+[~/][A-Za-z0-9_-]+$",
      "title": "Actor Id",
      "type": "string"
    },
    "build": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Build",
      "type": "string"
    },
    "enabled": {
      "default": false,
      "title": "Enabled",
      "type": "boolean"
    },
    "estimated_per_item_usd": {
      "maximum": 100,
      "minimum": 0,
      "title": "Estimated Per Item Usd",
      "type": "number"
    },
    "estimated_start_usd": {
      "default": 0,
      "maximum": 100,
      "minimum": 0,
      "title": "Estimated Start Usd",
      "type": "number"
    },
    "field_map": {
      "additionalProperties": {
        "pattern": "^[A-Za-z][A-Za-z0-9_]{0,80}$",
        "type": "string"
      },
      "propertyNames": {
        "enum": [
          "query",
          "keywords",
          "location",
          "locations",
          "limit"
        ]
      },
      "title": "Field Map",
      "type": "object"
    },
    "fixed_input": {
      "additionalProperties": true,
      "title": "Fixed Input",
      "type": "object"
    },
    "permission_evidence_url": {
      "format": "uri",
      "maxLength": 2048,
      "minLength": 1,
      "title": "Permission Evidence Url",
      "type": "string"
    },
    "platform_usage_included": {
      "default": false,
      "title": "Platform Usage Included",
      "type": "boolean"
    },
    "pricing_evidence_url": {
      "format": "uri",
      "maxLength": 2048,
      "minLength": 1,
      "title": "Pricing Evidence Url",
      "type": "string"
    },
    "pricing_model": {
      "const": "PAY_PER_EVENT",
      "title": "Pricing Model",
      "type": "string"
    },
    "review_expires_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Review Expires At"
    },
    "reviewed": {
      "default": false,
      "title": "Reviewed",
      "type": "boolean"
    },
    "schema_evidence_url": {
      "format": "uri",
      "maxLength": 2048,
      "minLength": 1,
      "title": "Schema Evidence Url",
      "type": "string"
    }
  },
  "required": [
    "actor_id",
    "build",
    "schema_evidence_url",
    "pricing_evidence_url",
    "permission_evidence_url",
    "pricing_model",
    "estimated_per_item_usd",
    "field_map"
  ],
  "title": "ActorConfiguration",
  "type": "object"
}
