{
  "$defs": {
    "TaskCapabilities": {
      "additionalProperties": false,
      "properties": {
        "assisted_fill": {
          "default": false,
          "title": "Assisted Fill",
          "type": "boolean"
        },
        "preview": {
          "const": true,
          "default": true,
          "title": "Preview",
          "type": "boolean"
        },
        "reviewed_submission": {
          "const": false,
          "default": false,
          "title": "Reviewed Submission",
          "type": "boolean"
        },
        "unattended_approved": {
          "const": false,
          "default": false,
          "title": "Unattended Approved",
          "type": "boolean"
        }
      },
      "title": "TaskCapabilities",
      "type": "object"
    },
    "TaskCounts": {
      "additionalProperties": false,
      "properties": {
        "completed": {
          "default": 0,
          "title": "Completed",
          "type": "integer"
        },
        "existing": {
          "default": 0,
          "title": "Existing",
          "type": "integer"
        },
        "manual": {
          "default": 0,
          "title": "Manual",
          "type": "integer"
        },
        "missing": {
          "default": 0,
          "title": "Missing",
          "type": "integer"
        },
        "ready": {
          "default": 0,
          "title": "Ready",
          "type": "integer"
        },
        "validation_errors": {
          "default": 0,
          "title": "Validation Errors",
          "type": "integer"
        }
      },
      "title": "TaskCounts",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "application_id": {
      "format": "uuid",
      "title": "Application Id",
      "type": "string"
    },
    "authorization_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Authorization Id"
    },
    "browser_connection": {
      "enum": [
        "connected",
        "paused",
        "disconnected",
        "unverified"
      ],
      "title": "Browser Connection",
      "type": "string"
    },
    "browser_session_id": {
      "format": "uuid",
      "title": "Browser Session Id",
      "type": "string"
    },
    "capabilities": {
      "$ref": "#/$defs/TaskCapabilities"
    },
    "challenge_observed": {
      "default": false,
      "title": "Challenge Observed",
      "type": "boolean"
    },
    "challenge_state": {
      "enum": [
        "NONE",
        "WIDGET_PRESENT_UNVERIFIED",
        "CHALLENGE_BLOCKING",
        "MANUALLY_RESOLVED_AND_SITE_VERIFIED",
        "UNKNOWN"
      ],
      "title": "Challenge State",
      "type": "string"
    },
    "company_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Company Name"
    },
    "context_digest": {
      "title": "Context Digest",
      "type": "string"
    },
    "counts": {
      "$ref": "#/$defs/TaskCounts"
    },
    "current_url": {
      "title": "Current Url",
      "type": "string"
    },
    "field_answer_revisions": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Field Answer Revisions",
      "type": "object"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "job_id": {
      "format": "uuid",
      "title": "Job Id",
      "type": "string"
    },
    "job_title": {
      "title": "Job Title",
      "type": "string"
    },
    "mode": {
      "const": "ASSISTED_FILL",
      "title": "Mode",
      "type": "string"
    },
    "network_guard_active": {
      "default": false,
      "title": "Network Guard Active",
      "type": "boolean"
    },
    "next_action": {
      "title": "Next Action",
      "type": "string"
    },
    "packet_revision": {
      "title": "Packet Revision",
      "type": "integer"
    },
    "plan_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Plan Id"
    },
    "profile_binding_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Profile Binding Id"
    },
    "profile_version": {
      "title": "Profile Version",
      "type": "integer"
    },
    "reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Reason"
    },
    "state": {
      "enum": [
        "DISCOVERED",
        "PACKET_READY",
        "FORM_INSPECTED",
        "NEEDS_INPUT",
        "ANSWERS_REVIEWED",
        "FILL_AUTHORIZED",
        "FILLING",
        "FILLED_VERIFIED",
        "READY_FOR_SUBMISSION",
        "PAUSED",
        "FAILED_RETRYABLE",
        "FAILED_FINAL",
        "CHALLENGE_REQUIRED",
        "SUBMISSION_UNKNOWN",
        "SUBMITTED_CONFIRMED"
      ],
      "title": "State",
      "type": "string"
    },
    "step": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Step"
    },
    "tab_active": {
      "title": "Tab Active",
      "type": "boolean"
    },
    "tab_id": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Tab Id"
    },
    "target_url": {
      "title": "Target Url",
      "type": "string"
    },
    "updated_at": {
      "title": "Updated At",
      "type": "string"
    },
    "verified_receipts": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Verified Receipts",
      "type": "array"
    },
    "version": {
      "title": "Version",
      "type": "integer"
    },
    "window_id": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Window Id"
    }
  },
  "required": [
    "id",
    "version",
    "application_id",
    "job_id",
    "company_name",
    "job_title",
    "packet_revision",
    "profile_version",
    "context_digest",
    "target_url",
    "current_url",
    "browser_session_id",
    "tab_id",
    "state",
    "challenge_state",
    "step",
    "plan_id",
    "authorization_id",
    "field_answer_revisions",
    "verified_receipts",
    "reason",
    "next_action",
    "mode",
    "capabilities",
    "counts",
    "browser_connection",
    "tab_active",
    "updated_at"
  ],
  "title": "ExtensionTask",
  "type": "object"
}
