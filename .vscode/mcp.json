{
  "servers": {
    "automated-apply-browser-v2": {
      "type": "stdio",
      "command": "${workspaceFolder}/backend/venv/bin/python",
      "args": [
        "-m",
        "backend.app.browser_v2.cli",
        "mcp"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONUNBUFFERED": "1"
      }
    },
    "hiringcafe": {
      "type": "http",
      "url": "https://hiringcafe.com/api/mcp"
    },
    "himalayas": {
      "type": "http",
      "url": "https://mcp.himalayas.app/mcp"
    },
    "apify": {
      "type": "http",
      "url": "https://mcp.apify.com?tools=search-actors,fetch-actor-details,search-apify-docs,fetch-apify-docs"
    },
    "supabase-automated-apply": {
      "type": "http",
      "url": "https://mcp.supabase.com/mcp?project_ref=luvdmwnlwaqgvfwlmlom&read_only=true&features=docs%2Cdatabase%2Cdebugging"
    }
  }
}
