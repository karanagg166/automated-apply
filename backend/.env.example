# ==============================================================================
# Job Pulse Agent - Backend Environment Configuration Template
# NOTE: Never commit actual secret keys or credentials to version control.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=false
APP_HOST=127.0.0.1
APP_PORT=8000

# Security
# Required by profile and saved-profile matching routes. Empty means fail closed (503).
# Generate locally: python -c "import secrets; print(secrets.token_urlsafe(32))"
JOB_AGENT_API_TOKEN=
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-in-production

# Supabase / PostgreSQL Direct Database Connection
# Dedicated isolated schema: job_agent
# secretlint-disable-next-line -- placeholder credentials, not a secret
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
DATABASE_SCHEMA=job_agent
DB_REMOTE_ONLY=true
DB_REQUIRE_TLS=true
# Optional path to the approved project's downloaded root CA certificate.
# Use direct PostgreSQL or the dashboard's session pooler (port 5432).
# Keep URL query parameters empty; asyncpg gets certificate-verified TLS separately.
DB_SSL_ROOT_CERT=
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=1
DB_ECHO=false

# Optional Supabase REST API Configuration (Used only when REST client is needed)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# FastMCP Server
FASTMCP_SERVER_NAME=Job Pulse Agent Tools
FASTMCP_MOUNT_PATH=/mcp

# Credit & Budget Limits (Default safety limits for development)
HUNTER_MONTHLY_LIMIT=25
APOLLO_MONTHLY_LIMIT=50
SERPER_MONTHLY_LIMIT=100
SIGNALHIRE_MONTHLY_LIMIT=5

# External Provider API Keys (Set when testing real providers in Phase 2)
HUNTER_API_KEY=
APOLLO_API_KEY=
SERPER_API_KEY=
SIGNALHIRE_API_KEY=

# Apify discovery: disabled until reviewed, explicitly enabled, and budgeted
APIFY_API_TOKEN=
APIFY_MONTHLY_LIMIT_USD=0
APIFY_PER_RUN_CAP_USD=0
APIFY_SOURCES={}
# Native execution additionally pins each selected portal (or portal:actor_id) to
# {"build_id":"opaque provider build ID","schema_digest":"reviewed SHA256"}.
# Empty review map leaves native paid execution unavailable; never paste credentials.
APIFY_BUILD_REVIEWS={}
GREENHOUSE_BOARDS={}
PEOPLE_SEARCH_ENABLED=false
DISCOVERY_TIMEOUT_SECONDS=90
DISCOVERY_MAX_CONCURRENCY=2

# Gmail API Configuration (OAuth 2.0 for Job Alert Ingestion)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=


# Candidate links — optional initial defaults, never applied at startup
CANDIDATE_RESUME_DRIVE_URL=
CANDIDATE_RESUME_DRIVE_FILE_ID=
# Initial defaults only. The owner explicitly saves source settings in My Profile.
# A running resume check worker is required; flags never launch a scheduler.
RESUME_DRIVE_SYNC_ENABLED=false
RESUME_DRIVE_SYNC_INTERVAL_HOURS=24
RESUME_DRIVE_SYNC_REQUIRES_REVIEW=true
CANDIDATE_GITHUB_URL=
CANDIDATE_ORIGINAL_LINKEDIN_URL=
CANDIDATE_PORTFOLIO_URL=
CANDIDATE_LEETCODE_URL=
CANDIDATE_CODEFORCES_URL=
CANDIDATE_GFG_URL=
CANDIDATE_HACKERRANK_URL=

# Server-side AI provider (independent of Codex credentials)
LLM_PROVIDER=gemini
LLM_MODEL=
GEMINI_API_KEY=
LLM_MAX_OUTPUT_TOKENS=1000
LLM_MAX_INPUT_CHARS=16000
LLM_TIMEOUT_SECONDS=30
LLM_MONTHLY_MAX_REQUESTS=200
LLM_MAX_CONCURRENCY=2

# Phase 3 professional contact enrichment (disabled by default)
APOLLO_ENRICHMENT_ENABLED=false
SIGNALHIRE_ENRICHMENT_ENABLED=false
APOLLO_PER_RUN_LIMIT=5
SIGNALHIRE_PER_RUN_LIMIT=2
# Set these to account-confirmed MAXIMUM credits for the selected synchronous lookup.
# Zero blocks billable execution; these are estimates, not provider balances/pricing.
APOLLO_CREDITS_PER_LOOKUP=0
SIGNALHIRE_CREDITS_PER_LOOKUP=0
CONTACT_ENRICHMENT_MAX_PEOPLE_PER_RUN=10
CONTACT_ENRICHMENT_MAX_CONCURRENCY=2
CONTACT_CACHE_TTL_DAYS=30
CONTACT_RETENTION_DAYS=90
CONTACT_PROVIDER_TIMEOUT_SECONDS=20

# Phase 4A MCP: one Streamable HTTP endpoint at /mcp/, off by default.
# Use a separate random token >=32 characters. Reusing JOB_AGENT_API_TOKEN is rejected.
MCP_REMOTE_ENABLED=false
MCP_API_TOKEN=
MCP_ALLOW_DRAFT_CREATION=false
MCP_MAX_REQUEST_BYTES=65536
MCP_MAX_CONCURRENCY=3
MCP_REQUEST_TIMEOUT_SECONDS=30
MCP_ALLOWED_HOSTS=["localhost","127.0.0.1","[::1]"]
MCP_ALLOWED_ORIGINS=[]
MCP_REQUIRE_TLS=true

# Phase 4A secondary Gmail: registered Web application redirect, never caller supplied.
GMAIL_REDIRECT_URI=
GMAIL_EXPECTED_EMAIL=
OAUTH_STATE_TTL_SECONDS=600
# Separate Fernet keyring in a secret manager/environment; generate each value with Fernet.generate_key().
# JSON mapping from immutable version IDs to keys. Never replace a key under an existing ID.
OAUTH_ENCRYPTION_KEYS={}
OAUTH_ACTIVE_KEY_ID=
# GMAIL_REFRESH_TOKEN above is legacy parser-only config, never automatically migrated.

# Phase 4B: owner-confirmed Gmail sends. Configure OAuth and explicitly upgrade first.
GMAIL_SENDING_ENABLED=false
# Product boundary: read and create draft only; legacy send opt-in is insufficient.
GMAIL_READ_DRAFT_ONLY=true
GMAIL_SEND_MAX_PER_DAY=10
GMAIL_SEND_MAX_PER_HOUR=3
GMAIL_SEND_MAX_RECIPIENTS=1
GMAIL_SEND_TIMEOUT_SECONDS=20
GMAIL_REQUIRE_EXPLICIT_CONFIRMATION=true
GMAIL_CONFIRMATION_TTL_SECONDS=300

# Phase 5A standalone application preparation uses JOB_AGENT_API_TOKEN and the existing
# Gemini limits above. No Naukri login, browser service, extension or submission credentials.
# Confirm/save the profile and CandidateResource resume; environment links alone are insufficient.
# REST works with MCP_REMOTE_ENABLED=false. The owner MCP token includes read_applications;
# application tools are read-only and do not inherit prepare_draft or Gmail send authority.
# Apply 008_application_preparation.sql after 001-007 only in an explicitly authorized environment.
# Disposable local migration verification (never point this at a production database):
# secretlint-disable-next-line -- placeholder credentials, not a secret
# PROFILE_TEST_DATABASE_URL=postgresql://postgres:TEST_PASSWORD@127.0.0.1:5432/candidate_profile_test

# Phase 6A startup intelligence. Public checks are owner-triggered, never scheduled.
# Migration 009 follows 001-008; no migration/deployment is performed automatically.
PROVIDER_VERIFICATION_TTL_HOURS=24
# Credentials, retained-content permission, and per-call cost approval are separate.
PUBLIC_SEARCH_RIGHTS_REVIEWED=false
PUBLIC_SEARCH_PERMISSION_EVIDENCE_URL=
# Exact approved official employer domains -> actual permission evidence URLs.
PUBLIC_SEARCH_ALLOWED_DOMAINS={}
# Leave false without applicable LinkedIn/content-owner consent and retention rights.
LINKEDIN_SEARCH_RETENTION_AUTHORIZED=false
# Existing APIFY_SOURCES entries also require platform_usage_included=true and
# account_spending_limit_verified=true after actual pricing/account hard-limit review.
# No actor is preselected, licensed or live-verified by this repository.

# Phase 6B: deployment fails closed in staging/production. Use staging-only secrets.
# Query-string DSN overrides are rejected by operator commands. Use asyncpg URL format.
DB_REQUIRE_TLS=true
# Host-only exact names, no wildcard. Empty blocks live-environment startup.
API_ALLOWED_HOSTS=[]
API_ALLOWED_ORIGINS=[]
API_REQUIRE_TLS=true
# Owner-confirmed hash of host:port/database/schema; credentials never printed.
STAGING_DATABASE_ID=
# This setting is a Literal[False]; submission cannot be enabled by configuration.
APPLICATION_SUBMISSION_ENABLED=false

# Phase 7: private owner frontend. Place values only in backend/.env, never NEXT_PUBLIC_*.
# Generate privately with backend/scripts/configure_frontend_owner.py.
FRONTEND_PASSWORD_HASH=
FRONTEND_SESSION_SECRET=
RESUME_ENCRYPTION_KEY=
# Local configuration; use exact HTTPS origins for any approved staging deployment.
FRONTEND_ORIGIN=http://localhost:3000
FRONTEND_LOCAL_HTTP=true
BACKEND_ORIGIN=http://127.0.0.1:8000
# Testing only; never enabled on a real environment.
UI_FIXTURE_MODE=false

# Cohere Chat V2 evaluation only. Never place keys in browser/Telegram configuration.
COHERE_API_KEY=
COHERE_MODEL=command-a-plus-05-2026
COHERE_ENABLED=false
COHERE_EVALUATION_KEY_CONFIRMED=false
COHERE_OWNER_TEXT_AUTHORIZED=false
COHERE_CANDIDATE_DATA_AUTHORIZED=false
COHERE_MONTHLY_MAX_REQUESTS=100
COHERE_MONTHLY_MAX_TOKENS=500000

# Chrome form filling is opt-in and cannot submit applications.
BROWSER_FILL_ENABLED=false
BROWSER_AUTOMATION_ENABLED=false
# Native command polling requires separate deployment approval and profile opt-in.
CHROME_PROFILE_COMMANDS_ENABLED=false
# BROWSER_FIXTURE_ORIGIN is testing-only; never configure with real candidate data.

# Controlled localhost fixture submissions only; live submissions are not implemented.
BROWSER_SUBMIT_ENABLED=false

# Optional browser assistance/review defaults; enable only after owner approval.
BROWSER_ASSISTANT_ENABLED=false
BROWSER_ALLOWED_ORIGINS=[]
BROWSER_ASSET_ORIGINS=[]
MULTI_SELECT_FIELDS_ENABLED=false
# Brave is the default; msedge selects installed Microsoft Edge. No browser fallback.
BROWSER_CHANNEL=brave
BROWSER_HEADLESS=false
BROWSER_PROFILE_ROOT=reports/browser-profiles
OLLAMA_ENABLED=false
OLLAMA_GENERATION_AUTHORIZED=false
OLLAMA_MODEL=
LLM_LOCAL_FALLBACK_ENABLED=false
APPROVED_ANSWER_REUSE_ENABLED=false
OPPORTUNITY_CONTEXT_ENABLED=false
GEMINI_ENABLED=false
GEMINI_APPROVED_MONTHLY_REQUESTS=0
COHERE_EVALUATION_ENABLED=false
COHERE_TRIAL_KEY_CONFIRMED=false
COHERE_DATA_SHARING_APPROVED=false
BROWSER_OWNER_APPROVAL_KEY=
BROWSER_MOCK_SUBMISSION_ENABLED=false

# Credential-free public ATS allowlists: {"reviewed-board-id":"Employer name"}
LEVER_BOARDS={}
LEVER_REGION=global
ASHBY_BOARDS={}

# Separate owner consent for candidate facts; never inferred from a key or budget.
GEMINI_CANDIDATE_DATA_AUTHORIZED=false

# Phase 3: disabled until separate account consent, selection, and scope review.
GMAIL_READ_SYNC_ENABLED=false
# Deferred to Phase 5.4; keep Gmail intake disabled throughout Phase 5.3.
NAUKRI_ALERT_EMAILS_ENABLED=false
GMAIL_READ_BODY_REVIEWED=false
# Free-account eligibility and endpoint evidence expires after 24 hours. No upgrade.
APOLLO_FREE_ACCOUNT_CONFIRMED=false
APOLLO_WORK_EMAIL_CONFIRMED=false
# APOLLO_ELIGIBILITY_REVIEWED_AT=2026-10-27T00:00:00Z
APOLLO_ELIGIBILITY_EVIDENCE_URL=
APOLLO_REVIEWED_ENDPOINTS=[]
APOLLO_CREDIT_POOL=
# Each enabled Apify Actor configuration also needs a timezone-aware
# review_expires_at no more than 24 hours in the future. Prices are not static.
APIFY_SOURCE_ROUTES={}

# Official public Posting API, GET only. Explicit company identifier -> reviewed name.
# Keep empty until specific employer boards have been selected.
SMARTRECRUITERS_BOARDS={}

# Separate reviewed Gmail draft creation; never enables sending.
GMAIL_DRAFTS_ENABLED=false
GMAIL_RETENTION_ENABLED=false
# Optional owner-scoped local mail and fixed-profile startup. All start disabled.
# Set only independently approved addresses; the restriction also fences legacy Gmail grants.
GMAIL_LOCAL_ACCOUNTS_ENABLED=false
GMAIL_LOCAL_ALLOWED_EMAILS=[]
APPLE_MAIL_ENABLED=false
APPLE_MAIL_ACCOUNT_POLICIES={}
CHROME_FIXED_PROFILE_LAUNCH_ENABLED=false

# Native local stdio MCP action groups; saved reads/previews remain available.
# These do not grant paid budgets, Actor review, application or Gmail send authority.
RUST_AGENT_MCP_ALLOW_DISCOVERY=false
RUST_AGENT_MCP_ALLOW_METADATA_INSPECTION=false

# Optional absolute path to the existing private reports/phase1 directory.
# The Connection Center reads selected prior receipts as saved evidence.
RUST_CONNECTION_EVIDENCE_DIR=

# Explicit legacy-compatible tool-free CLI writer; never selected as a fallback.
AGY_ENABLED=false
AGY_QUOTA_AUTHORIZED=false
AGY_MODEL=
AGY_EXECUTABLE=/opt/homebrew/bin/agy
AGY_EFFORT=high
AGY_TIMEOUT_SECONDS=60

# --- Python v2 Phase 5: quota-hit Gmail drafts (READ + DRAFT ONLY) + free enrichment ---
# Real values belong only in ~/Library/Application Support/Automated Apply/phase1.private.env.
# Gmail IMAP draft channel (Google Account -> Security -> App passwords; needs 2-Step Verification).
GMAIL_IMAP_EMAIL=
GMAIL_IMAP_APP_PASSWORD=
# auto = IMAP first, silent Mail.app fallback | imap | mail_app
MAIL_DRAFT_CHANNEL=auto
MAIL_APP_SENDER=
MAIL_APP_FALLBACK_DISABLED=false
# Optional PDF resume (<= 5 MB) attached to quota-hit drafts.
MAIL_DRAFT_RESUME_PATH=
# Enrichment daily free caps (APOLLO_API_KEY / APIFY_API_TOKEN / SIGNALHIRE_API_KEY above).
ENRICHMENT_APOLLO_DAILY_CAP=10
ENRICHMENT_APIFY_DAILY_CAP=5
ENRICHMENT_SIGNALHIRE_DAILY_CAP=5
APIFY_CONTACT_ACTOR_ID=vdrmota/contact-info-scraper
ENRICHMENT_FETCH_CAREERS_PAGE=true
# Max new jobs parked (and so drafted) per portal per day while its quota is hit.
QUOTA_FALLBACK_DAILY_CAP=10

# --- Phase 6A (all optional; empty = feature off / default) ---------------------------------
# Cerebras free tier (1M tokens/day) joins the free LLM fallback chain.
CEREBRAS_API_KEY=
# Owner-deployed fine-tuned model (HTTPS public endpoint only; localhost/LAN/private IPs refused).
CUSTOM_CLOUD_LLM_BASE_URL=
CUSTOM_CLOUD_LLM_API_KEY=
CUSTOM_CLOUD_LLM_MODEL=
# first | fallback
CUSTOM_CLOUD_LLM_PRIORITY=fallback
# postgres (default, zero extra RAM) | cloudamqp | upstash_redis
EVENT_BUS_BACKEND=postgres
EVENT_BUS_PG_NOTIFY=true
CLOUDAMQP_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Nightly Telegram digest hour in IST (0-23); DIGEST_DISABLED=true turns it off.
DIGEST_HOUR_IST=21
DIGEST_DISABLED=false
# Keychain / Google-chip auto re-login before an AUTH Telegram request (set-portal-cred CLI).
AUTO_LOGIN_DISABLED=false
# Optional comma-separated We Work Remotely RSS feeds (https://weworkremotely.com/... only).
WWR_FEEDS=

# --- LLM observability and evals (Langfuse Cloud, free Hobby tier) ---------------------------
# Put the real values in <repo>/.env only. With both keys blank, tracing is fully off.
# Every LLM router call becomes one trace (PII-scrubbed prompt, provider, tokens, failover).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU: https://cloud.langfuse.com   US: https://us.cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Kill switch: set to false to stop sending traces without removing the keys.
LANGFUSE_TRACING_ENABLED=true
# LLM-as-judge on screening answers (a second provider audits each LLM answer):
#   off | shadow (default: score only, needs Langfuse) | enforce (rejected answers go to Telegram)
AI_V2_JUDGE_MODE=shadow
