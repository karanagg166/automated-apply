# Supabase CLI cache is local, including project links
supabase/.temp/

# JavaScript dependencies use pnpm exclusively.
package-lock.json
npm-shrinkwrap.json
yarn.lock

# Browser-assistance test artifacts
frontend/test-results-browser/

# Retired Rust workspace build output (rust/ removed 2026-11-26; never re-add artifacts).
/target/

# Owner-local runtime data and preserved worktrees never belong in source commits.
/.local/
/.worktrees/

# Rolling owner report, repository snapshots and v2 runtime receipts.
# Receipts/screenshots normally live in ~/Library/Application Support/automated-apply/receipts.
/LATEST_REPORT.md
/repomix-output.xml
backend/screenshots/

# Agent tool local state (settings.local.json may hold permissions / local paths).
.claude/settings.local.json
.claude/*.lock
.claude/worktrees/
.codex/

# Local uploads and document storage (owner data, never committed).
/uploads/
/data/storage/
