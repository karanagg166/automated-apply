{
  "manifest_version": 3,
  "name": "Automated Apply \u2014 Application Assistant",
  "version": "1.3.14",
  "description": "Local Naukri queue controls, guarded ordinary-UI direct Apply and persistent history reconciliation. Unsupported forms require review.",
  "permissions": [
    "contextMenus",
    "activeTab",
    "nativeMessaging",
    "storage",
    "scripting",
    "declarativeNetRequest",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Apply with Automated Apply"
  },
  "options_page": "settings.html",
  "key": "",
  "optional_host_permissions": [
    "https://*/*"
  ],
  "minimum_chrome_version": "120"
}
